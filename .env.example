PORT=3000
DATABASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Fallback voice when a customer's receptionist profile has none. Provider: ElevenLabs, Google or Amazon.
OWL_TTS_PROVIDER=ElevenLabs
OWL_TTS_VOICE=UgBBYS2sOqTuMpoF3BR0
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
ADMIN_API_KEY=
DIAL_TIMEOUT_SECONDS=15
HOST=127.0.0.1
WIX_SITE_URL=https://www.hootowl.net
WIX_INTAKE_SECRET=
# Comma-separated Wix Pricing Plans plan IDs that grant access. Required: empty or unset rejects every plan (events are stored as ignored) and logs an error at startup.
WIX_PLAN_IDS=
# 64 hex characters each (openssl rand -hex 32). Keep in a secret store; losing them locks users out of 2FA / provisioned numbers.
TWOFA_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY=
# Sender for sign-in codes. Messages are only sent when SMS_SEND_ENABLED=true.
TWILIO_AUTH_FROM=
SMS_SEND_ENABLED=false
# Set to 1 only behind a trusted, single reverse proxy.
TRUST_PROXY=0
# Daily report-only check of Wix Pricing Plans orders against billing_subscriptions (docs/billing-reconcile.md).
# Both must be set or the check does nothing. The key needs only the permission to read Pricing Plans orders.
WIX_ORDERS_API_KEY=
WIX_SITE_ID=
